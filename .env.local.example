# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Neon Postgres pooled connection string (Neon console → project → Connect).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials).
# Authorized redirect URI: <your-site-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google account emails allowed to open /dashboard.
ALLOWED_EMAILS=parent@example.com,teacher@example.com

# Any random long string (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=
# Your deployed URL in production (Vercel), or http://localhost:3000 locally.
NEXTAUTH_URL=http://localhost:3000
